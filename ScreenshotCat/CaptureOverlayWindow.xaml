<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ScreenshotCat.CaptureOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ScreenshotCat Capture">
    <Grid
        x:Name="Root"
        Background="Transparent"
        KeyDown="Root_KeyDown"
        PointerPressed="Root_PointerPressed"
        PointerMoved="Root_PointerMoved"
        PointerReleased="Root_PointerReleased"
        PointerExited="Root_PointerExited">
        <Image x:Name="ScreenPreview" Stretch="Fill" />

        <!-- Window hover/selection chrome only: no full-screen dim mask. -->
        <Canvas x:Name="DimCanvas" IsHitTestVisible="False">
            <Rectangle
                x:Name="HoverShadow"
                Fill="#33000000"
                RadiusX="10"
                RadiusY="10"
                Visibility="Collapsed" />
            <Rectangle
                x:Name="SelectionBorder"
                Stroke="#FF18A0FB"
                StrokeThickness="3"
                Fill="#2218A0FB"
                RadiusX="6"
                RadiusY="6"
                Visibility="Collapsed" />
        </Canvas>

        <Canvas x:Name="AnnotationCanvas" IsHitTestVisible="False" />

        <Border
            x:Name="HoverHintPill"
            Padding="12,6"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#E0182030"
            BorderBrush="#6618A0FB"
            BorderThickness="1"
            CornerRadius="14"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <TextBlock
                x:Name="HoverHintText"
                FontSize="12"
                Foreground="#EAF4FF"
                Text="右键长按选中窗口" />
        </Border>

        <Border
            x:Name="ModeToolbar"
            Height="50"
            Padding="10,8"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Margin="0"
            Background="#EE121820"
            CornerRadius="0"
            BorderBrush="#55A0C4E8"
            BorderThickness="0,0,0,1"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <TextBlock
                    x:Name="WrapModeText"
                    VerticalAlignment="Center"
                    Text="全屏批注"
                    FontSize="12"
                    Foreground="White"
                    Opacity="0.9" />
                <Button
                    x:Name="AnnotationModeButton"
                    MinWidth="96"
                    Padding="12,4"
                    Click="AnnotationModeButton_Click"
                    Content="结束批注" />
                <Button
                    x:Name="SaveCaptureButton"
                    MinWidth="86"
                    Padding="12,4"
                    Click="SaveCaptureButton_Click"
                    Content="保存截图" />
            </StackPanel>
        </Border>

        <Border
            x:Name="SavedNotesPanel"
            Width="320"
            MaxHeight="260"
            Padding="10,8"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="12,64,12,12"
            Background="#CC111111"
            CornerRadius="8"
            BorderBrush="#88AAAAAA"
            BorderThickness="1"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <ScrollViewer
                x:Name="SavedNotesScroller"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SavedNotesList" Spacing="8" />
            </ScrollViewer>
        </Border>

        <Border
            x:Name="NotePanel"
            Width="420"
            Padding="12"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="0"
            Background="#F5222222"
            CornerRadius="8"
            Visibility="Collapsed">
            <TextBox
                x:Name="NoteBox"
                Header="批注"
                KeyDown="NoteBox_KeyDown"
                PlaceholderText="输入批注后按 Enter 保存" />
        </Border>
    </Grid>
</Window>
